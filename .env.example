# Copiar a .env y configurar valores locales. No subir .env a Git.
# Generar secretos propios; no reutilizar credenciales antiguas.
PORT=3000
KEY=
POSTGRES_HOST=localhost
POSTGRES_SHEMA=public
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
POSTGRES_DATABASE=flex_ml_local

# OAuth: completar con credenciales propias.
CLIENT_ID=
CLIENT_SECRET=
CODE=
REDIRECT_URI=http://localhost:3000/callback

ACCESS_TOKEN_SECRET_KEY=
JWT_EXPIRATION_TIME=1h
JWT_EXPIRATION_TIME_CHANGE_PASSWORD=15m
JWT_CHANGE_EXPIRATION_TIME=15m
JWT_EXPIRATION_TIME_REFRESH=7d
